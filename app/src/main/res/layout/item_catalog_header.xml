<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/cat_list_horizontal_padding"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/header_category_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        tools:text="Games &amp; minigames" />

    <TextView
        android:id="@+id/header_category_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_count_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="1dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        tools:text="6" />

    <ImageView
        android:id="@+id/header_category_chevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_down"
        app:tint="@color/text_muted" />
</LinearLayout>
