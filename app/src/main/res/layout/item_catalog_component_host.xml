<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/cat_list_horizontal_padding"
    android:paddingTop="2dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/components_host_page"
        android:textColor="@color/text_faint"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/component_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_component_card"
        android:padding="10dp" />
</LinearLayout>
